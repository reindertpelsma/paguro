def char_keys(c):
    if c.isascii() and c.isalpha():
        return (["shift", c.lower()] if c.isupper() else [c])
    if c.isascii() and c.isdigit():
        return [c]
    if c in PLAIN:
        return [PLAIN[c]]
    if c in SHIFTED:
        return ["shift", SHIFTED[c]]
    die(f"cannot type {c!r} (US layout, ASCII only)")


def send_keys(qmp, keys, hold_ms=60):
    qmp.cmd("send-key", keys=[{"type": "qcode", "data": k} for k in keys], **{"hold-time": hold_ms})


def combo_keys(combo):
    return [KEY_ALIASES.get(k.lower(), k.lower()) for k in combo.replace("+", "-").split("-") if k]


def mouse_click(qmp, x, y, w, h, button="left", double=False):
    ax = round(x * 0x7FFF / max(w - 1, 1))
    ay = round(y * 0x7FFF / max(h - 1, 1))
    qmp.cmd("input-send-event", events=[{"type": "abs", "data": {"axis": "x", "value": ax}},
                                        {"type": "abs", "data": {"axis": "y", "value": ay}}])
    time.sleep(0.05)
    for _ in range(2 if double else 1):
        for down in (True, False):
            qmp.cmd("input-send-event", events=[{"type": "btn", "data": {"down": down, "button": button}}])
            time.sleep(0.05)


def load_gray(path):
    from PIL import Image
    import numpy as np
    return np.asarray(Image.open(path).convert("L"), dtype=np.float64)


def find_template(img, tpl):
    """Best match of tpl in img by mean squared difference (FFT correlation)."""
    import numpy as np
    H, W = img.shape
    h, w = tpl.shape
    if h > H or w > W:
        return None, float("inf")
    fs = (H + h, W + w)
    corr = np.fft.irfft2(np.fft.rfft2(img, fs) * np.conj(np.fft.rfft2(tpl, fs)), fs)[:H - h + 1, :W - w + 1]
    ii = np.pad(np.cumsum(np.cumsum(img * img, 0), 1), ((1, 0), (1, 0)))
    win = ii[h:, w:] - ii[:-h, w:] - ii[h:, :-w] + ii[:-h, :-w]
    mse = (win - 2 * corr + (tpl * tpl).sum()) / (h * w)
    y, x = np.unravel_index(np.argmin(mse), mse.shape)
    return (int(x), int(y)), float(mse[y, x])


# ---------------------------------------------------------------- commands

def cmd_start(a):
    if not os.path.exists(BASE):
        die(f"no base image at {BASE}; run `winvm build` first")
    os.makedirs(RUN, exist_ok=True)
    overlay = os.path.join(RUN, "overlay.qcow2")
    vars_fd = os.path.join(RUN, "vars.fd")
    tpm = os.path.join(RUN_TPM, "state")
    fresh = not (a.keep and os.path.exists(overlay))
    if fresh:
        for p in (overlay, vars_fd):
            if os.path.exists(p):
                os.unlink(p)
        shutil.rmtree(tpm, ignore_errors=True)
        subprocess.run(["qemu-img", "create", "-q", "-f", "qcow2", "-F", "qcow2", "-b", BASE, overlay], check=True)
        shutil.copyfile(BASE_VARS, vars_fd)
        shutil.copytree(BASE_TPM, tpm)
    log("fresh overlay" if fresh else "keeping previous overlay state")
    launch(overlay, vars_fd, tpm, a.secure_boot, vnc=a.vnc, paguro_vm=a.paguro_vm)
    if a.no_wait:
        return
    t0 = time.time()
    if not wait_ssh(a.timeout):
        die(f"ssh not reachable after {a.timeout}s (VM still running; winvm screenshot to look)")
    log(f"ssh ready after {time.time() - t0:.0f}s")


def cmd_stop(a):
    pid = running()
    if not pid:
        log("not running")
        return
    try:
        qmp = QMP()
        qmp.cmd("quit" if a.force else "system_powerdown")
        qmp.close()
    except (OSError, RuntimeError, ConnectionError) as e:
        log(f"QMP: {e}")
    if not wait_pid_gone(pid, 5 if a.force else a.timeout):
        log(f"qemu pid {pid} still alive after {a.timeout}s: SIGTERM")
        os.kill(pid, signal.SIGTERM)
        wait_pid_gone(pid, 10)
    tpm = read_pid("swtpm.pid", RUN_TPM)
    if tpm:
        os.kill(tpm, signal.SIGTERM)
    log("stopped")


def cmd_status(a):
    pid = running()

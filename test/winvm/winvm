def cmd_ssh(a):
    if not a.cmd:
        os.execvp("ssh", ssh_base(tty=True) + ["paguro@127.0.0.1"])
    sys.exit(ssh_run(" ".join(a.cmd)).returncode)


def cmd_scp(a):
    def conv(p):
        return "paguro@127.0.0.1:" + p[1:] if p.startswith(":") else p
    argv = ["scp", "-i", KEY, "-P", str(SSH_PORT), "-o", "StrictHostKeyChecking=no",
            "-o", "UserKnownHostsFile=/dev/null", "-o", "LogLevel=ERROR"]
    if a.recursive:
        argv.append("-r")
    sys.exit(subprocess.run(argv + [conv(a.src), conv(a.dst)]).returncode)



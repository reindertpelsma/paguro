# ---------------------------------------------------------------- QMP

class QMP:
    def __init__(self, path=None):
        self.s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.s.settimeout(120)
        self.s.connect(path or os.path.join(RUN, "qmp.sock"))
        self.f = self.s.makefile("rwb")
        self._read()  # greeting
        self.cmd("qmp_capabilities")

    def _read(self):
        while True:
            line = self.f.readline()
            if not line:
                raise ConnectionError("QMP closed")
            msg = json.loads(line)
            if "event" not in msg:
                return msg

    def cmd(self, execute, **args):
        req = {"execute": execute}
        if args:
            req["arguments"] = args
        self.f.write(json.dumps(req).encode() + b"\n")
        self.f.flush()
        r = self._read()
        if "error" in r:
            raise RuntimeError(f"QMP {execute}: {r['error'].get('desc')}")
        return r.get("return")

    def close(self):
        # the makefile() object holds the fd open too; QEMU serves one QMP
        # client at a time, so a half-closed socket blocks every later caller
        self.f.close()
        self.s.close()

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.close()


# ---------------------------------------------------------------- process state

def read_pid(name, d=None):
    try:
        with open(os.path.join(d or RUN, name)) as f:
            pid = int(f.read().strip())
    except (OSError, ValueError):
        return None
    return pid if pid_alive(pid) else None


def running():
    return read_pid("qemu.pid")


def pid_alive(pid):
    # a zombie counts as gone: `build` launches QEMU itself and would never
    # see it exit otherwise
    try:
        with open(f"/proc/{pid}/stat") as f:
            return f.read().rsplit(")", 1)[1].split()[0] != "Z"
    except (FileNotFoundError, IndexError):
        return False


def wait_pid_gone(pid, timeout):
    end = time.time() + timeout
    while time.time() < end:
        if not pid_alive(pid):
            try:
                os.waitpid(pid, os.WNOHANG)   # reap our own child, if it is one
            except ChildProcessError:
                pass
            return True
        time.sleep(1)
    return False


# ---------------------------------------------------------------- launch

def qemu_argv(disk, vars_fd, secure_boot, cdroms=(), vnc=None, serial=None, paguro_vm=False):
    code = OVMF_CODE_SB if secure_boot else OVMF_CODE_NOSB
    machine = "q35,accel=kvm" + (",smm=on" if secure_boot else "")
    a = ["qemu-system-x86_64", "-name", "winvm",
         "-machine", machine,
         "-cpu", CPU_MODEL,
         "-smp", CPUS, "-m", MEM,
         "-rtc", "base=utc,driftfix=slew",
         "-drive", f"if=pflash,format=raw,unit=0,readonly=on,file={code}",
         "-drive", f"if=pflash,format=raw,unit=1,file={vars_fd}"]
    if secure_boot:
        a += ["-global", "driver=cfi.pflash01,property=secure,value=on"]
    a += ["-chardev", f"socket,id=chrtpm,path={RUN_TPM}/swtpm.sock",
          "-tpmdev", "emulator,id=tpm0,chardev=chrtpm",
          "-device", "tpm-crb,tpmdev=tpm0",
          # AHCI: inbox driver, TRIM passes through to the qcow2 (discard=unmap)
          "-drive", f"if=none,id=disk0,file={disk},format=qcow2,discard=unmap,"
                    "detect-zeroes=unmap,cache=writeback",
          "-device", "ide-hd,drive=disk0,bus=ide.0,rotation_rate=1,bootindex=0"]
    for i, cd in enumerate(cdroms):
        if cd.startswith("https://"):
            a += ["-blockdev", json.dumps({"driver": "https", "url": cd, "node-name": f"cdf{i}",
                                           "read-only": True, "readahead": 64 << 20,
                                           "timeout": 120}),
                  "-blockdev", f"driver=raw,file=cdf{i},node-name=cd{i},read-only=on"]
        else:
            a += ["-blockdev", f"driver=file,filename={cd},node-name=cdf{i},read-only=on",
                  "-blockdev", f"driver=raw,file=cdf{i},node-name=cd{i},read-only=on"]
        a += ["-device", f"ide-cd,drive=cd{i},bus=ide.{i + 1},bootindex={i + 1}"]
    a += ["-netdev", f"user,id=n0,hostfwd=tcp:127.0.0.1:{SSH_PORT}-:22",
          "-device", "e1000e,netdev=n0",
          "-device", "qemu-xhci,id=xhci", "-device", "usb-tablet,bus=xhci.0",
          "-vga", "std", "-display", "none",
          "-serial", f"file:{serial or os.path.join(RUN, 'serial.log')}",
          "-qmp", f"unix:{RUN}/qmp.sock,server=on,wait=off",
          "-pidfile", f"{RUN}/qemu.pid"]
    if vnc is not None:
        a += ["-vnc", f"127.0.0.1:{vnc}"]
    if paguro_vm:
        # the OEM string the minifilter looks for (windows/minifilter/README.md)
        a += ["-smbios", "type=11,value=paguro-vm/1"]
    return a


def launch(disk, vars_fd, tpm_dir, secure_boot, cdroms=(), vnc=None, paguro_vm=False):
    """Start swtpm + QEMU inside one transient systemd scope capped at 10G."""
    if running():
        die("a VM is already running (winvm stop first)")
    os.makedirs(RUN, exist_ok=True)
    os.makedirs(RUN_TPM, exist_ok=True)
    for f in (f"{RUN}/qmp.sock", f"{RUN_TPM}/swtpm.sock", f"{RUN}/qemu.pid", f"{RUN_TPM}/swtpm.pid"):
        try:
            os.unlink(f)
        except FileNotFoundError:
            pass
    swtpm = ["swtpm", "socket", "--tpm2", "--tpmstate", f"dir={tpm_dir}",
             "--ctrl", f"type=unixio,path={RUN_TPM}/swtpm.sock", "--terminate",
             "--daemon", "--pid", f"file={RUN_TPM}/swtpm.pid", "--log", f"file={RUN_TPM}/swtpm.log"]
    qemu = qemu_argv(disk, vars_fd, secure_boot, cdroms, vnc, paguro_vm=paguro_vm)
    q = lambda v: "'" + v.replace("'", "'\\''") + "'"
    script = " ".join(map(q, swtpm)) + " && exec " + " ".join(map(q, qemu))
    env = dict(os.environ, XDG_RUNTIME_DIR=os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
    unit = f"winvm-{int(time.time())}"
    out = open(os.path.join(RUN, "qemu.log"), "ab")
    subprocess.Popen(["systemd-run", "--user", "--scope", "--collect", "--unit", unit,
                      "-p", f"MemoryMax={SCOPE_MEMORY_MAX}", "--", "sh", "-c", script],
                     stdin=subprocess.DEVNULL, stdout=out, stderr=out, env=env,
                     start_new_session=True)
    end = time.time() + 30
    while time.time() < end:
        if running() and os.path.exists(os.path.join(RUN, "qmp.sock")):
            log(f"VM up: pid {running()}, scope {unit}, ssh 127.0.0.1:{SSH_PORT}, "
                f"secure boot {'on' if secure_boot else 'off'}")
            return
        time.sleep(0.5)
    die(f"VM did not start; see {RUN}/qemu.log")


# ---------------------------------------------------------------- ssh

def ssh_base(tty=False):
    return ["ssh", "-i", KEY, "-p", str(SSH_PORT), "-o", "StrictHostKeyChecking=no",
            "-o", "UserKnownHostsFile=/dev/null", "-o", "LogLevel=ERROR",
            "-o", "ConnectTimeout=5", "-o", "ServerAliveInterval=15"] + (["-t"] if tty else [])


def ssh_run(cmd, check=False, capture=False, timeout=None):
    r = subprocess.run(ssh_base() + ["paguro@127.0.0.1", cmd], text=True,
                       capture_output=capture, timeout=timeout)
    if check and r.returncode:
        die(f"ssh {cmd!r} exited {r.returncode}")
    return r


def wait_ssh(timeout):
    end = time.time() + timeout
    while time.time() < end:
        if not running():
            die("VM exited while waiting for ssh")
        try:
            r = ssh_run("echo winvm-ready", capture=True, timeout=20)
            if "winvm-ready" in r.stdout:
                return True
        except subprocess.TimeoutExpired:
            pass
        time.sleep(3)
    return False


# ---------------------------------------------------------------- screen / input

def screendump(path):
    path = os.path.abspath(path)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    qmp = QMP()
    try:
        qmp.cmd("screendump", filename=path, format="png")
    finally:
        qmp.close()
    return path


def png_size(path):
    with open(path, "rb") as f:
        head = f.read(24)
    return struct.unpack(">II", head[16:24])


KEY_ALIASES = {"win": "meta_l", "super": "meta_l", "meta": "meta_l", "enter": "ret",

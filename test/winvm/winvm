        time.sleep(0.1)
    qmp.close()


def cmd_click(a):
    with tempfile.TemporaryDirectory() as d:
        w, h = png_size(screendump(os.path.join(d, "s.png")))
    qmp = QMP()
    mouse_click(qmp, a.x, a.y, w, h, a.button, a.double)
    qmp.close()


def cmd_wait_screen(a):
    """wait-screen <seconds>: wait until the screen stops changing.
       wait-screen <template.png>: wait until the template appears."""
    import numpy as np
    try:
        timeout, tpl = float(a.pattern), None
    except ValueError:
        timeout, tpl = a.timeout, load_gray(a.pattern)
    end = time.time() + timeout
    prev, stable_since = None, None
    with tempfile.TemporaryDirectory() as d:
        shot = os.path.join(d, "s.png")
        while time.time() < end:
            img = load_gray(screendump(shot))
            if tpl is not None:
                pos, mse = find_template(img, tpl)
                if mse <= a.threshold:
                    x, y = pos[0] + tpl.shape[1] // 2, pos[1] + tpl.shape[0] // 2
                    print(f"{x} {y}")  # centre of the match, ready for `winvm click`
                    return
            else:
                if prev is not None and prev.shape == img.shape and np.abs(prev - img).mean() < 0.05:
                    stable_since = stable_since or time.time()
                    if time.time() - stable_since >= a.stable:
                        print("stable")
                        return
                else:
                    stable_since = None
                prev = img
            time.sleep(1)
    if a.out:
        shutil.copyfile(shot, a.out)
    die("wait-screen: timed out", 2)


# ---------------------------------------------------------------- build

def fetch_payload():
    d = os.path.join(WINVM_DIR, "payload")
    os.makedirs(d, exist_ok=True)
    for name, url, algo, digest in PAYLOAD:
        p = os.path.join(d, name)
        if not os.path.exists(p):
            log(f"downloading {name}")
            urllib.request.urlretrieve(url, p + ".part")
            os.rename(p + ".part", p)
        if algo:
            h = hashlib.new(algo)
            with open(p, "rb") as f:
                for b in iter(lambda: f.read(1 << 20), b""):
                    h.update(b)
            if h.hexdigest() != digest:
                die(f"{name}: {algo} mismatch")
    return d


def verify_iso(src):
    log(f"verifying ISO SHA-256 ({'streamed' if src.startswith('https://') else 'local'})")
    h = hashlib.sha256()
    f = urllib.request.urlopen(src) if src.startswith("https://") else open(src, "rb")
    with f:
        for b in iter(lambda: f.read(8 << 20), b""):
            h.update(b)
    if h.hexdigest() != ISO_SHA256:
        die(f"ISO SHA-256 {h.hexdigest()} != published {ISO_SHA256}")
    log("ISO SHA-256 matches Microsoft's published hash")


def make_cfg_iso(out):
    with open(os.path.join(WINVM_DIR, "keys", "password")) as f:
        password = f.read().strip()
    with tempfile.TemporaryDirectory() as st:
        with open(os.path.join(HERE, "autounattend.xml")) as f:
            xml = f.read().replace("@PASSWORD@", password)
        with open(os.path.join(st, "autounattend.xml"), "w") as f:
            f.write(xml)
        shutil.copy(os.path.join(HERE, "winvm-setup.ps1"), st)
        shutil.copy(KEY + ".pub", os.path.join(st, "authorized_keys"))
        shutil.copytree(fetch_payload(), os.path.join(st, "payload"))
        subprocess.run(["genisoimage", "-quiet", "-J", "-r", "-joliet-long", "-V", "WINVMCFG",
                        "-o", out, st], check=True)


def ensure_secrets():
    k = os.path.join(WINVM_DIR, "keys")
    os.makedirs(k, exist_ok=True)
    if not os.path.exists(KEY):
        subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "winvm-paguro", "-f", KEY], check=True)
    pw = os.path.join(k, "password")
    if not os.path.exists(pw):
        import secrets
        with open(pw, "w") as f:
            f.write("Pg-" + secrets.token_urlsafe(12) + "\n")
        os.chmod(pw, 0o600)


def set_link(up):
    with QMP() as qmp:
        qmp.cmd("set_link", name="n0", up=up)


def watch_install(t0, timeout, link_down=False):
    """Wait for phase 1 to power off. With link_down, the NIC stays unplugged
    until the first-logon script starts: OOBE's "Checking for updates" would
    otherwise pull cumulative updates into the base image."""
    logs = os.path.join(WINVM_DIR, "logs")
    serial = os.path.join(RUN, "serial.log")
    pid, n = running(), 0
    while pid and not wait_pid_gone(pid, 20 if link_down else 60):
        if link_down:
            try:
                with open(serial, errors="replace") as f:
                    if "winvm-setup" in f.read():
                        set_link(True)
                        link_down = False
                        log("first-logon setup started: network link up")
            except FileNotFoundError:
                pass
        n += 1
        if time.time() - t0 > timeout:
            die("install timed out (VM left running; winvm screenshot / winvm stop)")
        try:
            screendump(os.path.join(logs, "build-latest.png"))
        except (OSError, RuntimeError, ConnectionError):
            pass
        if n % 5 == 0:
            try:
                with open(os.path.join(RUN, "serial.log"), errors="replace") as f:
                    tail = [l for l in f.read().splitlines() if "winvm-setup" in l][-1:]
            except FileNotFoundError:
                tail = []
            log(f"installing, {(time.time() - t0) / 60:.0f} min {tail[0] if tail else ''}")


def cmd_build(a):
    if os.path.exists(BASE) and not a.force:
        die(f"{BASE} exists (use --force to rebuild)")
    logs = os.path.join(WINVM_DIR, "logs")
    os.makedirs(logs, exist_ok=True)
    os.makedirs(RUN, exist_ok=True)
    vars_fd, tpm = BASE_VARS + ".tmp", BASE_TPM + ".tmp"
    # the image being installed; --resume --disk names another top of the
    # chain (e.g. after a live blockdev-snapshot to a disk with more room)
    disk = a.disk or BASE + ".tmp"
    t0 = time.time()
    if a.resume:
        log("resuming after phase 1" + (" (waiting for the running install)" if running() else ""))
        watch_install(t0, a.timeout)
    else:
        if running():
            die("a VM is running")
        ensure_secrets()
        if not a.skip_verify:
            verify_iso(a.iso)
        cfg = os.path.join(RUN, "cfg.iso")
        make_cfg_iso(cfg)
        for p in (disk, vars_fd):
            if os.path.exists(p):
                os.unlink(p)
        shutil.rmtree(tpm, ignore_errors=True)
        os.makedirs(tpm)
        subprocess.run(["qemu-img", "create", "-q", "-f", "qcow2", "-o", "cluster_size=64k,lazy_refcounts=on",
                        disk, a.disk_size], check=True)
        shutil.copyfile(OVMF_VARS_MS, vars_fd)
        # phase 1: Secure Boot on, install + first-logon setup, which powers off
        launch(disk, vars_fd, tpm, secure_boot=True, cdroms=[a.iso, cfg], vnc=a.vnc)
        with QMP() as qmp:
            end = time.time() + 45   # "Press any key to boot from CD or DVD..."
            while time.time() < end:
                send_keys(qmp, ["ret"])
                time.sleep(0.7)
            qmp.cmd("set_link", name="n0", up=False)
        watch_install(t0, a.timeout, link_down=True)
    t1 = time.time()
    log(f"phase 1 (install + setup) finished after {(t1 - t0) / 60:.1f} min")
    try:
        shutil.copyfile(os.path.join(RUN, "serial.log"), os.path.join(logs, "build-serial.log"))
    except FileNotFoundError:
        pass

    # phase 2: Secure Boot off (testsigning is refused under SB), set testsigning
    launch(disk, vars_fd, tpm, secure_boot=False, vnc=a.vnc)
    if not wait_ssh(900):
        die("phase 2: ssh never came up")
    ssh_run("bcdedit /set testsigning on", check=True)
    # start the evaluation's 90-day activation (online); an unactivated eval
    # reports "grace time expired" and nags / shuts down
    ssh_run("cscript //nologo %windir%\\system32\\slmgr.vbs /ato & "
            "cscript //nologo %windir%\\system32\\slmgr.vbs /xpr")
    ssh_run("type C:\\winvm\\setup.log")
    pid = running()
    ssh_run("shutdown /s /t 0")
    if not wait_pid_gone(pid, 300):
        die("phase 2: VM did not power off")
    log(f"phase 2 finished in {(time.time() - t1) / 60:.1f} min")

    if os.path.exists(BASE):
        os.chmod(BASE, 0o644)
    if a.no_compress:
        # needs no extra space: the install image (and its backing chain,
        # if any) becomes the base as is
        if disk != BASE + ".tmp":
            subprocess.run(["qemu-img", "commit", "-q", "-b", os.path.realpath(BASE + ".tmp"), disk], check=True)
        os.replace(os.path.realpath(BASE + ".tmp"), BASE)
        if os.path.islink(BASE + ".tmp"):
            os.unlink(BASE + ".tmp")
    else:
        # one self-contained, compressed image (about half the size; needs
        # that much free space next to the install image while it runs)
        log("writing the compressed base image")
        subprocess.run(["qemu-img", "convert", "-c", "-p", "-O", "qcow2", "-o", "cluster_size=64k",
                        disk, BASE + ".new"], check=True)
        os.replace(BASE + ".new", BASE)
        if disk == BASE + ".tmp":
            os.unlink(os.path.realpath(disk))
            if os.path.islink(disk):
                os.unlink(disk)
        else:
            log(f"left the install chain ({disk} and its backing files) for you to delete")
    os.chmod(BASE, 0o444)
    os.replace(vars_fd, BASE_VARS)
    shutil.rmtree(BASE_TPM, ignore_errors=True)
    os.replace(tpm, BASE_TPM)
    log(f"base image ready: {BASE} ({os.path.getsize(BASE) / 2**30:.1f} GiB), "
        f"total {(time.time() - t0) / 60:.1f} min")


# ---------------------------------------------------------------- main

def main():
    p = argparse.ArgumentParser(prog="winvm", description=__doc__.splitlines()[0])
    sp = p.add_subparsers(dest="command", required=True)

    b = sp.add_parser("build", help="install the base image (unattended)")
    b.add_argument("--iso", default=ISO_URL, help="ISO path or https URL (default: streamed from Microsoft)")
    b.add_argument("--skip-verify", action="store_true")
    b.add_argument("--disk-size", default="80G")
    b.add_argument("--timeout", type=int, default=3 * 3600)
    b.add_argument("--force", action="store_true")
    b.add_argument("--resume", action="store_true",
                   help="skip the install: wait for a running phase 1, then finish")
    b.add_argument("--no-compress", action="store_true",
                   help="keep the install image as the base instead of a compressed copy")
    b.add_argument("--disk", help="with --resume: the image to finish (default base.qcow2.tmp)")
    b.add_argument("--vnc", type=int, metavar="DISPLAY")
    b.set_defaults(fn=cmd_build)

    s = sp.add_parser("start", help="boot from a fresh overlay of the base image")
    s.add_argument("--keep", action="store_true", help="reuse the previous overlay (keep state)")
    s.add_argument("--secure-boot", action="store_true",
                   help="enforce Secure Boot (testsigning then has no effect)")
    s.add_argument("--vnc", type=int, metavar="DISPLAY", help="also serve VNC on 127.0.0.1:590N")
    s.add_argument("--paguro-vm", action="store_true",
                   help="add the SMBIOS type 11 'paguro-vm/1' marker (minifilter loads active)")
    s.add_argument("--no-wait", action="store_true", help="do not wait for ssh")
    s.add_argument("--timeout", type=int, default=600)
    s.set_defaults(fn=cmd_start)

    s = sp.add_parser("stop", help="ACPI power-off (then quit, then SIGTERM the qemu pid)")
    s.add_argument("--force", action="store_true", help="QMP quit immediately")
    s.add_argument("--timeout", type=int, default=120)
    s.set_defaults(fn=cmd_stop)

    sp.add_parser("status").set_defaults(fn=cmd_status)

    s = sp.add_parser("ssh", help="run a command (cmd.exe) as paguro, or an interactive shell")
    s.add_argument("cmd", nargs=argparse.REMAINDER)
    s.set_defaults(fn=cmd_ssh)

    s = sp.add_parser("scp", help="copy files; prefix the guest side with ':' (e.g. :C:/winvm/)")
    s.add_argument("-r", "--recursive", action="store_true")
    s.add_argument("src")
    s.add_argument("dst")
    s.set_defaults(fn=cmd_scp)

    s = sp.add_parser("screenshot", help="QMP screendump to PNG")
    s.add_argument("out")
    s.set_defaults(fn=cmd_screenshot)

    s = sp.add_parser("type", help="type ASCII text (US layout)")
    s.add_argument("text")
    s.add_argument("--enter", action="store_true", help="press Enter afterwards")
    s.add_argument("--delay", type=float, default=0.03)
    s.set_defaults(fn=cmd_type)

    s = sp.add_parser("key", help="press key combos, e.g. ctrl-alt-delete win-r alt-f4 ret")
    s.add_argument("combo", nargs="+")
    s.add_argument("--hold", type=int, default=80, help="hold time in ms")
    s.set_defaults(fn=cmd_key)

    s = sp.add_parser("click", help="click at screen pixel x y (usb-tablet)")
    s.add_argument("x", type=int)
    s.add_argument("y", type=int)
    s.add_argument("--button", default="left", choices=["left", "right", "middle"])
    s.add_argument("--double", action="store_true")
    s.set_defaults(fn=cmd_click)

    s = sp.add_parser("wait-screen", help="<seconds>: wait for a still screen; <tpl.png>: wait for a match")
    s.add_argument("pattern")
    s.add_argument("--timeout", type=float, default=300, help="for a template (default 300 s)")
    s.add_argument("--stable", type=float, default=5, help="seconds unchanged counted as still")
    s.add_argument("--threshold", type=float, default=150.0, help="max mean squared difference for a match")
    s.add_argument("--out", help="save the last screenshot here on timeout")
    s.set_defaults(fn=cmd_wait_screen)

    a = p.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()

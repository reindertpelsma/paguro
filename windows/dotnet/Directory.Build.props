<Project>
  <!-- Every C# project of the Windows side (INTERFACES.md §11.7). -->
  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <PaguroApiSchema>$(MSBuildThisFileDirectory)..\api\paguro-api.json</PaguroApiSchema>
    <PaguroApiFixtures>$(MSBuildThisFileDirectory)..\api\fixtures</PaguroApiFixtures>
    <PaguroStrings>$(MSBuildThisFileDirectory)..\..\themes\default\strings</PaguroStrings>
  </PropertyGroup>
</Project>

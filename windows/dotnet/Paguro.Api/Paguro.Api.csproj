<Project Sdk="Microsoft.NET.Sdk">
  <!-- The API's C# face: types generated from windows/api/paguro-api.json at
       build time, and the JSON-RPC client of \\.\pipe\paguro. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Paguro.Api</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Paguro.Api.Codegen\Paguro.Api.Codegen.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=net8.0" />
  </ItemGroup>
  <PropertyGroup>
    <PaguroGenerated>$(BaseIntermediateOutputPath)generated\PaguroApi.g.cs</PaguroGenerated>
  </PropertyGroup>
  <Target Name="PaguroGenerateApi" BeforeTargets="CoreCompile" DependsOnTargets="ResolveProjectReferences" Inputs="$(PaguroApiSchema)" Outputs="$(PaguroGenerated)">
    <MSBuild Projects="..\Paguro.Api.Codegen\Paguro.Api.Codegen.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=net8.0">
      <Output TaskParameter="TargetOutputs" PropertyName="PaguroCodegenDll" />
    </MSBuild>
    <Exec Command="dotnet &quot;$(PaguroCodegenDll)&quot; &quot;$(PaguroApiSchema)&quot; &quot;$(PaguroGenerated)&quot;" />
  </Target>
  <Target Name="PaguroIncludeGenerated" BeforeTargets="CoreCompile" AfterTargets="PaguroGenerateApi">
    <ItemGroup>
      <Compile Include="$(PaguroGenerated)" />
      <FileWrites Include="$(PaguroGenerated)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="$(PaguroApiSchema)" LogicalName="paguro-api.json" />
  </ItemGroup>
</Project>

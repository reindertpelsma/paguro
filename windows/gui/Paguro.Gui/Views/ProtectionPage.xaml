<Page
    x:Class="Paguro.Gui.Views.ProtectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Paguro.Gui"
    xmlns:vm="using:Paguro.Gui.ViewModels"
    xmlns:api="using:Paguro.Api">
    <ScrollViewer>
        <StackPanel Spacing="8" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="{local:Str Key=protection_title}" AutomationProperties.AutomationId="PageTitle" />
            <TextBlock Style="{StaticResource Lead}" Text="{local:Str Key=protection_lead}" />
            <TextBlock Style="{StaticResource Error}" Text="{x:Bind VM.Error, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind VM.NotAsked, Mode=OneWay}" IsClosable="False" Severity="Informational"
                     AutomationProperties.AutomationId="NotAsked" Message="{local:Str Key=protection_not_asked}" />
            <StackPanel Spacing="8" Visibility="{x:Bind VM.Asked, Mode=OneWay}">
                <TextBlock Style="{StaticResource Note}" Text="{x:Bind VM.WindowsText, Mode=OneWay}" AutomationProperties.AutomationId="WindowsLevel" />
                <ListView x:Name="ChoiceList" AutomationProperties.AutomationId="Choices" ItemsSource="{x:Bind VM.Choices}"
                          SelectionMode="Single" SelectionChanged="Choice_Changed">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChoiceItem">
                            <StackPanel Padding="4,8" Spacing="2" AutomationProperties.AutomationId="{x:Bind local:Ids.Choice(Id)}"
                                        AutomationProperties.Name="{x:Bind Title}" IsHitTestVisible="{x:Bind Offered}" Opacity="{x:Bind local:Conv.Dim(Offered)}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Badge}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Explanation}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Reason}" Style="{StaticResource Note}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Spacing="8" Visibility="{x:Bind VM.NeedsSecret, Mode=OneWay}">
                    <ComboBox x:Name="KeyboardBox" Header="{local:Str Key=keyboard_label}" AutomationProperties.AutomationId="Keyboard"
                              ItemsSource="{x:Bind VM.Keyboards}" SelectionChanged="Keyboard_Changed" MinWidth="280">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="api:KeyboardLayout">
                                <TextBlock Text="{x:Bind Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Style="{StaticResource Note}" Text="{local:Str Key=keyboard_why}" />
                    <PasswordBox x:Name="Secret" Header="{x:Bind VM.SecretLabel, Mode=OneWay}" AutomationProperties.AutomationId="Secret"
                                 PasswordChanged="Secret_Changed" MaxWidth="360" HorizontalAlignment="Left" Width="360" />
                    <PasswordBox x:Name="Again" Header="{local:Str Key=again}" AutomationProperties.AutomationId="SecretAgain"
                                 PasswordChanged="Again_Changed" MaxWidth="360" HorizontalAlignment="Left" Width="360" />
                    <TextBlock Style="{StaticResource Error}" Text="{x:Bind VM.Refused, Mode=OneWay}" AutomationProperties.AutomationId="Refused" />
                    <TextBlock Style="{StaticResource Error}" Text="{local:Str Key=mismatch}" Visibility="{x:Bind VM.Mismatch, Mode=OneWay}" />
                    <CheckBox x:Name="Bypass" AutomationProperties.AutomationId="PinBypass" Content="{local:Str Key=pin_bypass}"
                              Visibility="{x:Bind VM.ShowPinBypass, Mode=OneWay}" Click="Bypass_Click" />
                    <TextBlock Style="{StaticResource Note}" Text="{local:Str Key=pin_bypass_why}" Visibility="{x:Bind VM.ShowPinBypass, Mode=OneWay}" />
                </StackPanel>
                <Button Style="{StaticResource AccentButtonStyle}" Content="{local:Str Key=protection_apply}" AutomationProperties.AutomationId="Apply" Command="{x:Bind VM.Apply}" />
                <TextBlock TextWrapping="Wrap" Text="{x:Bind VM.Result, Mode=OneWay}" AutomationProperties.AutomationId="Result" />
            </StackPanel>
            <Expander Header="{local:Str Key=explain_title}" HorizontalAlignment="Stretch" Margin="0,16,0,0">
                <StackPanel Spacing="8">
                    <TextBlock TextWrapping="Wrap" Text="{local:Str Key=explain_tpm}" />
                    <TextBlock TextWrapping="Wrap" Text="{local:Str Key=explain_recovery}" />
                    <TextBlock TextWrapping="Wrap" Text="{local:Str Key=explain_passphrase_rung}" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>

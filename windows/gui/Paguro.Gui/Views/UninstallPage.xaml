<Page
    x:Class="Paguro.Gui.Views.UninstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Paguro.Gui">
    <ScrollViewer>
        <StackPanel Spacing="8" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="{local:Str Key=uninstall_title}" AutomationProperties.AutomationId="PageTitle" />
            <TextBlock Style="{StaticResource Lead}" Text="{local:Str Key=uninstall_lead}" />
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{local:Str Key=uninstall_touched}" />
                    <ItemsControl ItemsSource="{x:Bind VM.Touched}" AutomationProperties.AutomationId="Touched">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{local:Str Key=uninstall_untouched}" />
                    <ItemsControl ItemsSource="{x:Bind VM.Untouched}" AutomationProperties.AutomationId="Untouched">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
            <RadioButtons x:Name="ImagesChoice" Header="{local:Str Key=uninstall_images_choose}" AutomationProperties.AutomationId="ImagesChoice" SelectionChanged="Images_Changed">
                <RadioButton Content="{local:Str Key=uninstall_images_keep}" AutomationProperties.AutomationId="KeepImages" />
                <RadioButton Content="{local:Str Key=uninstall_images_delete}" AutomationProperties.AutomationId="DeleteImages" />
            </RadioButtons>
            <TextBlock Style="{StaticResource Error}" Text="{x:Bind VM.Error, Mode=OneWay}" />
            <Button Content="{local:Str Key=uninstall_now}" AutomationProperties.AutomationId="Uninstall" Command="{x:Bind VM.Uninstall}" />
            <ProgressBar Value="{x:Bind VM.Operation.Percent, Mode=OneWay, FallbackValue=0}" Maximum="100" />
            <TextBlock TextWrapping="Wrap" Text="{x:Bind VM.Result, Mode=OneWay}" AutomationProperties.AutomationId="Result" />
        </StackPanel>
    </ScrollViewer>
</Page>

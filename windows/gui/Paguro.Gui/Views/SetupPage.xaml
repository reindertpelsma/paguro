<Page
    x:Class="Paguro.Gui.Views.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Paguro.Gui">
    <ScrollViewer>
        <StackPanel Spacing="8" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="{local:Str Key=setup_title}" AutomationProperties.AutomationId="PageTitle" />
            <TextBlock Style="{StaticResource Lead}" Text="{local:Str Key=setup_lead}" />
            <ItemsControl ItemsSource="{x:Bind VM.Rows, Mode=OneWay}" AutomationProperties.AutomationId="SetupRows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Error}" Text="{x:Bind VM.Error, Mode=OneWay}" />
            <Button Content="{local:Str Key=repair_now}" AutomationProperties.AutomationId="Repair" Command="{x:Bind VM.Repair}" />
            <ProgressBar Value="{x:Bind VM.Operation.Percent, Mode=OneWay, FallbackValue=0}" Maximum="100" />
            <TextBlock TextWrapping="Wrap" Text="{x:Bind VM.Result, Mode=OneWay}" AutomationProperties.AutomationId="Result" />
        </StackPanel>
    </ScrollViewer>
</Page>

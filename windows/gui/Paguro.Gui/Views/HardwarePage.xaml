<Page
    x:Class="Paguro.Gui.Views.HardwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Paguro.Gui"
    xmlns:vm="using:Paguro.Gui.ViewModels">
    <ScrollViewer>
        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource PageTitle}" Text="{local:Str Key=hardware_title}" AutomationProperties.AutomationId="PageTitle" />
            <TextBlock Style="{StaticResource Lead}" Text="{local:Str Key=hardware_lead}" />
            <TextBlock Style="{StaticResource Error}" Text="{x:Bind VM.Error, Mode=OneWay}" />
            <ItemsControl AutomationProperties.AutomationId="HardwareRows" ItemsSource="{x:Bind VM.Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HardwareRow">
                        <Grid ColumnSpacing="16" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Kind}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Text}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,24,0,0" Text="{local:Str Key=hardware_told}" />
            <TextBlock Style="{StaticResource Lead}" Text="{local:Str Key=hardware_told_lead}" />
            <ItemsControl AutomationProperties.AutomationId="Modaliases" ItemsSource="{x:Bind VM.Told}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" FontFamily="Consolas" IsTextSelectionEnabled="True" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>

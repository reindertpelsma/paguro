<Page
    x:Class="Paguro.Gui.Views.RestartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Paguro.Gui"
    xmlns:api="using:Paguro.Api">
    <ScrollViewer>
        <StackPanel Spacing="8" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="{local:Str Key=restart_title}" AutomationProperties.AutomationId="PageTitle" />
            <TextBlock Style="{StaticResource Lead}" Text="{local:Str Key=restart_lead}" />
            <ComboBox x:Name="EntryBox" Header="{local:Str Key=restart_entry}" AutomationProperties.AutomationId="Entry"
                      ItemsSource="{x:Bind VM.Entries}" SelectionChanged="Entry_Changed" MinWidth="280" />
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" Text="{local:Str Key=restart_summary}" />
            <ItemsControl ItemsSource="{x:Bind VM.Summary}" AutomationProperties.AutomationId="Summary">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{x:Bind VM.Problems}" AutomationProperties.AutomationId="Problems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="api:PreflightCheck">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Note}">
                            <Run Text="{x:Bind State}" /> <Run Text="{x:Bind Id}" />: <Run Text="{x:Bind Detail}" />
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Error}" Text="{x:Bind VM.Error, Mode=OneWay}" />
            <Button Style="{StaticResource AccentButtonStyle}" Content="{local:Str Key=restart_now}" AutomationProperties.AutomationId="Restart" Command="{x:Bind VM.Restart}" />
            <TextBlock TextWrapping="Wrap" Text="{x:Bind VM.Result, Mode=OneWay}" AutomationProperties.AutomationId="Result" />
        </StackPanel>
    </ScrollViewer>
</Page>

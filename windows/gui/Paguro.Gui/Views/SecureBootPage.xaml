<Page
    x:Class="Paguro.Gui.Views.SecureBootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Paguro.Gui">
    <ScrollViewer>
        <StackPanel Spacing="8" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="{local:Str Key=secureboot_title}" AutomationProperties.AutomationId="PageTitle" />
            <TextBlock Style="{StaticResource Lead}" Text="{local:Str Key=secureboot_lead}" />
            <TextBlock Style="{StaticResource Error}" Text="{x:Bind VM.Error, Mode=OneWay}" />
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" Text="{x:Bind VM.Headline, Mode=OneWay}" AutomationProperties.AutomationId="Headline" />
            <StackPanel Spacing="8" Visibility="{x:Bind VM.ShowMok, Mode=OneWay}" AutomationProperties.AutomationId="MokExplanation">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{local:Str Key=mok_title}" />
                <TextBlock TextWrapping="Wrap" Text="{local:Str Key=mok_what}" />
                <Border Padding="16" CornerRadius="6" Background="#0000AA" MaxWidth="560" HorizontalAlignment="Left">
                    <StackPanel Spacing="4">
                        <TextBlock Foreground="White" FontFamily="Consolas" Text="Shim UEFI key management" />
                        <TextBlock Foreground="White" FontFamily="Consolas" Text="Press any key to perform MOK management" />
                        <TextBlock Foreground="White" FontFamily="Consolas" Text="  Enroll MOK" />
                        <TextBlock Foreground="White" FontFamily="Consolas" Text="  Continue" />
                        <TextBlock Foreground="White" FontFamily="Consolas" Text="  Yes" />
                        <TextBlock Foreground="White" FontFamily="Consolas" Text="Password:" />
                    </StackPanel>
                </Border>
                <TextBlock TextWrapping="Wrap" Text="{local:Str Key=mok_step_1}" />
                <TextBlock TextWrapping="Wrap" Text="{local:Str Key=mok_step_2}" />
                <TextBlock TextWrapping="Wrap" Text="{local:Str Key=mok_step_3}" />
                <TextBlock TextWrapping="Wrap" Text="{local:Str Key=mok_step_4}" />
                <TextBlock TextWrapping="Wrap" Text="{local:Str Key=mok_password}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap" Text="{local:Str Key=mok_safe}" />
            </StackPanel>
            <InfoBar IsOpen="{x:Bind VM.DbChange, Mode=OneWay}" IsClosable="False" Severity="Warning"
                     Title="{local:Str Key=db_title}" Message="{local:Str Key=db_body}" AutomationProperties.AutomationId="DbChange" />
            <InfoBar IsOpen="{x:Bind VM.BitLockerSuspend, Mode=OneWay}" IsClosable="False" Severity="Informational"
                     Title="{local:Str Key=suspend_title}" Message="{local:Str Key=suspend_body}" AutomationProperties.AutomationId="Suspend" />
            <TextBlock TextWrapping="Wrap" Style="{StaticResource Note}" Text="{local:Str Key=sb_off_why}" Visibility="{x:Bind VM.Off, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>

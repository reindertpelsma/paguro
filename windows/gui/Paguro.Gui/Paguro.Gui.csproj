<Project Sdk="Microsoft.NET.Sdk">
  <!-- The paguro GUI (INTERFACES.md §11.8): WinUI 3, unpackaged and
       self-contained, unelevated; views over Paguro.Gui.Core's view models,
       which talk to the service over \\.\pipe\paguro. Built with MSBuild on
       Windows (the WinUI XAML compiler is Windows-only). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Paguro.Gui</RootNamespace>
    <AssemblyName>paguro-app</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Generated XAML code and CsWinRT warn; the core library keeps the strict settings. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Nullable>annotations</Nullable>
  </PropertyGroup>
  <!-- `dotnet publish -p:PublishSingleFile=true`: one paguro-app.exe
       (INTERFACES §11.7a), everything self-extracted on first start. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <!-- The Windows App SDK embeds resources.pri in the single file only with MSIX tooling on. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Paguro.Gui.Core\Paguro.Gui.Core.csproj" />
  </ItemGroup>
</Project>

<Window
    x:Class="Paguro.Gui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Paguro.Gui">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <InfoBar x:Name="Banner" AutomationProperties.AutomationId="Banner" Severity="Warning" IsClosable="False"
                 IsOpen="{x:Bind BannerOpen, Mode=OneWay}" Message="{x:Bind VM.Session.Banner, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button x:Name="InstallService" AutomationProperties.AutomationId="InstallService"
                        Content="{local:Str Key=install_service}" Command="{x:Bind VM.InstallService}"
                        Visibility="{x:Bind VM.Session.NoService, Mode=OneWay}" />
            </InfoBar.ActionButton>
        </InfoBar>
        <NavigationView x:Name="Nav" Grid.Row="1" AutomationProperties.AutomationId="Nav"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="Left"
                        OpenPaneLength="260" SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="checks" AutomationProperties.AutomationId="nav_checks" Content="{local:Str Key=page_checks}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D5;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="distributions" AutomationProperties.AutomationId="nav_distributions" Content="{local:Str Key=page_distributions}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="hardware" AutomationProperties.AutomationId="nav_hardware" Content="{local:Str Key=page_hardware}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE950;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="protection" AutomationProperties.AutomationId="nav_protection" Content="{local:Str Key=page_protection}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE72E;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="secureboot" AutomationProperties.AutomationId="nav_secureboot" Content="{local:Str Key=page_secureboot}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE83D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="restart" AutomationProperties.AutomationId="nav_restart" Content="{local:Str Key=page_restart}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE777;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="uninstall" AutomationProperties.AutomationId="nav_uninstall" Content="{local:Str Key=page_uninstall}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE74D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="PageFrame" Padding="32,24,32,24" />
        </NavigationView>
    </Grid>
</Window>

# Sourced into the VM's /init by vm-coexist.sh, after ok/bad and module
# loading. Coexistence (views A and C of one NTFS volume live at once, under
# stress), growth, power-loss replay (INTERFACES 12.1) and the view-C guard
# (10.4). Disks, in order:
#   vda  NTFS, 512-byte sectors      vdb  NTFS, 4096-byte sectors (4Kn)
#   vdc  dm-log-writes log           vdd  replay target (vda's size)
#   vde  disk.vhd    vdf  bare.img   vdg  disk4k.vhd   vdh  bare4k.img
# /layout.env: D1_*/D4_* partition offsets, SCALE, PHASES, EFSCK, REPLAY.
. /layout.env
mkdir -p /mnt/p /mnt/c /mnt/r1 /mnt/r2 /mnt/e1 /mnt/x /mnt/y
dmc() { dmsetup create "$@" 2>/tmp/dmerr && dmsetup mknodes; }
lim() { pgctl status | awk -v c="$1" '$1 == "claim" && $2 == c { for (i = 1; i < NF; i++) if ($i == "sectors") print $(i + 1) }'; }
cstat() { pgctl status | awk -v c="$1" -v k="$2" '$1 == "claim" && $2 == c { for (i = 1; i < NF; i++) if ($i == k) print $(i + 1) }'; }
vstat() { pgctl status | awk -v v="$1" -v k="$2" '$1 == "volume" && $2 == v { for (i = 1; i < NF; i++) if ($i == k) print $(i + 1) }'; }
has() { case " $PHASES " in *" $1 "*) return 0 ;; esac; return 1; }
# The disk with virtio serial $1 (the optional ones: frag, guard).
disk() { for b in /sys/block/vd*; do [ "$(cat $b/serial 2>/dev/null)" = "$1" ] && echo /dev/${b##*/}; done; }
info() { echo "INFO: $*"; }
ops() { echo $(($1 * SCALE)); }

dmesg -c > /tmp/boot.dmesg
insmod /dm-paguro.ko && ok "insmod" || bad "insmod"

# ---- building a volume ---------------------------------------------------------
# populate <ntfs-dev> <frag 0|1|built> <disk-image-dev> <bare-image-dev>
# ("built": the host already wrote the images, fragmented, through ntfs-3g)
# The free space is shaped through ntfs3 (with frag=1: filled with 1 MiB
# files, three of every four freed, so only 3 MiB holes remain); the images are then
# written by libntfs-3g's ntfscp. Not by ntfs3: ntfs3 creates MFT records in
# the NTFS 3.0 layout (update sequence at 0x2A, no self record number),
# which the core refuses (INTERFACES 10.1a) -- see README "Findings".
# Sets ID1/ID2 ("rec seq") and NX1/NX2 (extent counts).
populate() {
    if [ "$2" != built ]; then
    mount -t ntfs3 "$1" /mnt/p || { bad "ntfs3 mounts $1"; return 1; }
    mkdir -p /mnt/p/paguro /mnt/p/pad
    if [ "$2" = 1 ]; then
        i=0
        while dd if=/dev/zero of=/mnt/p/pad/$i bs=1M count=1 2>/dev/null; do i=$((i + 1)); done
        rm -f /mnt/p/pad/$i
        j=0; while [ $j -lt $i ]; do [ $((j % 4)) = 3 ] || rm /mnt/p/pad/$j; j=$((j + 1)); done
    fi
    umount /mnt/p
    for f in "$3 disk.vhd" "$4 bare.img"; do
        set -- $f
        dd if="$1" of=/tmp/img bs=1M 2>/dev/null &&
            ntfscp -f "$dev" /tmp/img "/paguro/$2" > /dev/null 2>/tmp/ntfscp.err ||
            { bad "ntfscp $2: $(cat /tmp/ntfscp.err)"; rm -f /tmp/img; return 1; }
        rm -f /tmp/img
    done
    fi
    mount -t ntfs3 "$dev" /mnt/p || { bad "ntfs3 remounts $dev"; return 1; }
    rm -rf /mnt/p/pad
    ID1=$(pgctl ident /mnt/p/paguro/disk.vhd); ID2=$(pgctl ident /mnt/p/paguro/bare.img)
    NX1=$(pgctl fiemap /mnt/p/paguro/disk.vhd | wc -l); NX2=$(pgctl fiemap /mnt/p/paguro/bare.img | wc -l)
    umount /mnt/p
    info "images in place: disk.vhd $ID1 ($NX1 extents), bare.img $ID2 ($NX2 extents)"
}

# ---- stress ---------------------------------------------------------------
# Every job appends its exit status to /tmp/jobs; stress_wait checks them.
job() { name=$1; shift; ( "$@" > "/tmp/job.$name" 2>&1; echo "$name $?" >> /tmp/jobs ) & }
stress_wait() {
    wait
    while read -r n s; do
        [ "$s" = 0 ] && ok "$1: $n" || { bad "$1: $n exited $s"; tail -5 "/tmp/job.$n"; }
    done < /tmp/jobs
    : > /tmp/jobs
}
: > /tmp/jobs

# stress <label> <seed>: ext4 trees and block overwrites on both images, the
# ESP (FAT) churned, and next to them the NTFS allocator churned by many
# small files and then filled to ENOSPC.
stress() {
    s=$2
    job r1tree pgstress tree /mnt/r1/t$s $s "$(ops 4000)" /tmp/m.r1.$s
    job r1blk pgstress blocks /mnt/r1/blk$s 24 $((s + 1)) "$(ops 3000)" /tmp/b.r1.$s direct
    job r2tree pgstress tree /mnt/r2/t$s $((s + 2)) "$(ops 4000)" /tmp/m.r2.$s
    job r2blk pgstress blocks /mnt/r2/blk$s 24 $((s + 3)) "$(ops 3000)" /tmp/b.r2.$s
    job esp pgstress tree /mnt/e1/t$s $((s + 4)) "$(ops 600)" /tmp/m.e1.$s
    job ntfs pgstress tree /mnt/c/churn$s $((s + 5)) "$(ops 6000)" /tmp/m.c.$s
    if [ -x /bin/fio ]; then
        job fio fio --name=img --filename=/mnt/r1/fio$s --size=24M --rw=randwrite \
            --bs=4k --direct=1 --ioengine=psync --verify=crc32c --do_verify=1 \
            --number_ios="$(ops 3000)" --randseed=$s
    fi
    # Fill NTFS to ENOSPC while the images are still being written.
    sleep 2
    job fill pgstress fill /mnt/c/fill$s $((s + 6)) /tmp/m.f.$s
    stress_wait "$1"
}

# verify_all <seed> <tag>: every file and block the stress left, as read now.
verify_all() {
    s=$1
    for p in "r1 /mnt/r1/t$s" "r2 /mnt/r2/t$s" "e1 /mnt/e1/t$s" "c /mnt/c/churn$s" "f /mnt/c/fill$s"; do
        set -- $p
        [ -e "/tmp/m.$1.$s" ] || continue
        pgstress verify "$2" "/tmp/m.$1.$s" > /tmp/v.out 2>&1 &&
            ok "$tag: files intact on $1 ($(tail -1 /tmp/v.out))" || { bad "$tag: $1 corrupt"; head -5 /tmp/v.out; }
    done
    for p in "r1 /mnt/r1/blk$s" "r2 /mnt/r2/blk$s"; do
        set -- $p
        pgstress blockverify "$2" "/tmp/b.$1.$s" > /tmp/v.out 2>&1 &&
            ok "$tag: blocks intact on $1" || { bad "$tag: $1 blocks corrupt"; head -5 /tmp/v.out; }
    done
}

mount_all() { # mount_all <ro|rw>
    mount -t ntfs3 -o "$1" /dev/mapper/pvc /mnt/c &&
        mount -t ext4 -o "$1" /dev/mapper/pa1root /mnt/r1 &&
        mount -t ext4 -o "$1" /dev/mapper/pa2 /mnt/r2 &&
        mount -t vfat -o "$1" /dev/mapper/pa1esp /mnt/e1
}
umount_all() { umount /mnt/e1; umount /mnt/r1; umount /mnt/r2; umount /mnt/c; }

# check_offline <tag>: filesystems unmounted, caches dropped.
check_offline() {
    tag=$1
    sync; echo 3 > /proc/sys/vm/drop_caches
    for d in pa1root pa2; do
        e2fsck -fn /dev/mapper/$d > /tmp/fsck.out 2>&1 &&
            ok "$tag: e2fsck -fn clean on $d" || { bad "$tag: e2fsck $d"; tail -15 /tmp/fsck.out; }
    done
    if [ -x /sbin/fsck.fat ]; then
        fsck.fat -n /dev/mapper/pa1esp > /tmp/fsck.out 2>&1 &&
            ok "$tag: fsck.fat -n clean on the ESP" || { bad "$tag: fsck.fat"; tail -8 /tmp/fsck.out; }
    fi
    ntfsfix -n /dev/mapper/pvc > /tmp/ntfsfix.out 2>&1 &&
        grep -q "processed successfully" /tmp/ntfsfix.out &&
        ok "$tag: ntfsfix -n finds nothing on the NTFS" || { bad "$tag: ntfsfix"; cat /tmp/ntfsfix.out; }
    if [ -x /sbin/ntfsck ]; then
        # On the volume itself: ntfsck reads more than ntfs3 does, and what
        # it reads of a claimed file through view C is refused (see below).
        ntfsck -n -q "$VDEV" > /tmp/ntfsck.out 2>&1 &&
            ok "$tag: ntfsck -n clean" || { bad "$tag: ntfsck"; tail -15 /tmp/ntfsck.out; }
    fi
}

# maps_agree <tag> <dev>: our parser (Rust and C) over the raw volume gives
# exactly the claims' maps (the module compares), which are what they were.
maps_agree() {
    mtag=$1 mdev=$2
    for i in 1 2; do
        eval "id=\$ID$i c=\$C$i"
        paguro-harness ntfs-map "$mdev" $id > /tmp/map.now.$i 2>/tmp/map.err ||
            { bad "$mtag: Rust and C disagree on image $i: $(cat /tmp/map.err)"; continue; }
        pgctl crosscheck-list "$c" /tmp/map.now.$i > /dev/null &&
            ok "$mtag: re-parsed runlist of image $i = the module's claim ($(wc -l < /tmp/map.now.$i) extents)" ||
            bad "$mtag: re-parsed runlist of image $i differs from the claim"
    done
}

# guard_quiet <tag> <volume>: nothing but readahead met the claimed extents.
guard_quiet() {
    g=$(vstat "$2" guard); a=$(vstat "$2" readahead)
    [ "$g" = 0 ] && ok "$1: no guard hits on view C (readahead refused: $a)" ||
        bad "$1: $g guard hits on view C"
    for c in $C1 $C2; do
        [ "$(cstat "$c" refused)" = 0 ] || bad "$1: view A of claim $c refused I/O"
    done
}

# ---- one volume, start to finish ------------------------------------------
# run <tag> <ntfs-dev> <frag> <disk-dev> <bare-dev> <D1|D4> <record 0|1> <grow 0|1>
run() {
    rtag=$1 dev=$2 frag=$3 ddev=$4 bdev=$5 lay=$6 rec=$7 grow=$8
    populate "$dev" "$frag" "$ddev" "$bdev" || return
    eval "ESP_S=\$${lay}_ESP_START ESP_N=\$${lay}_ESP_LEN ROOT_S=\$${lay}_ROOT_START ROOT_N=\$${lay}_ROOT_LEN"
    N=$(blockdev --getsz "$dev")
    VDEV=$dev
    if [ "$rec" = 1 ]; then
        dd if="$dev" of=/dev/vdd bs=4M 2>/dev/null && sync
        dmc lw --table "0 $N log-writes $dev /dev/vdc" || { bad "log-writes: $(cat /tmp/dmerr)"; return; }
        VDEV=/dev/mapper/lw
    fi
    V=$(pgctl add "$VDEV" "$VDEV" 2>/dev/null) || { bad "$rtag: volume add: $V"; return; }
    C1=$(pgctl claim "$V" $ID1 vhd 2>/dev/null) || { bad "$rtag: claim disk.vhd: $C1"; return; }
    C2=$(pgctl claim "$V" $ID2 2>/dev/null) || { bad "$rtag: claim bare.img: $C2"; return; }
    for i in 1 2; do
        eval "id=\$ID$i"
        paguro-harness ntfs-map "$VDEV" $id > /tmp/map.pre.$i || bad "$rtag: map $i"
    done
    dmc pvc --table "0 $N paguro-volume $V c" || { bad "$rtag: view C: $(cat /tmp/dmerr)"; return; }
    mount -t ntfs3 /dev/mapper/pvc /mnt/c || { bad "$rtag: ntfs3 on view C"; return; }
    pgctl crosscheck "$C1" /mnt/c/paguro/disk.vhd > /dev/null &&
        pgctl crosscheck "$C2" /mnt/c/paguro/bare.img > /dev/null &&
        ok "$rtag: FIEMAP agrees with both claims" || {
            bad "$rtag: cross-check"
            for f in disk.vhd bare.img; do
                echo "FIEMAP $f: $(pgctl fiemap /mnt/c/paguro/$f | tr '\n' ' ') size $(stat -c %s /mnt/c/paguro/$f)"
            done
            echo "derived: $(tr '\n' ' ' < /tmp/map.pre.1) / $(tr '\n' ' ' < /tmp/map.pre.2)"
        }
    umount /mnt/c
    dmc pa1 --table "0 $(lim "$C1") paguro-image $C1" &&
        dmc pa2 --table "0 $(lim "$C2") paguro-image $C2" &&
        ok "$rtag: view A of both images passes the payload check (GPT+FAT+ext4, bare ext4)" ||
        { bad "$rtag: view A: $(cat /tmp/dmerr)"; return; }
    dmc pa1esp --table "0 $ESP_N linear /dev/mapper/pa1 $ESP_S" &&
        dmc pa1root --table "0 $ROOT_N linear /dev/mapper/pa1 $ROOT_S" || bad "$rtag: partitions"
    mount_all rw && ok "$rtag: ext4 x2 and FAT on view A, ntfs3 on view C, all read-write at once" ||
        { bad "$rtag: mounts"; return; }
    [ "$rec" = 1 ] && dmsetup message lw 0 mark stress
    stress "$rtag" 11
    sync
    tag="$rtag (live)"; verify_all 11
    umount_all
    check_offline "$rtag"
    mount_all ro && { tag="$rtag (after remount)"; verify_all 11; umount_all; } || bad "$rtag: ro remount"
    maps_agree "$rtag" "$VDEV"; guard_quiet "$rtag" "$V"
    for i in 1 2; do
        cmp -s /tmp/map.pre.$i /tmp/map.now.$i && ok "$rtag: image $i's runlist unchanged by the stress" ||
            bad "$rtag: image $i's runlist changed"
    done
    if [ "$grow" = 1 ]; then
        growth "$rtag" "$rec" 23 0
        [ "$frag" = built ] && [ $(($(cstat "$C2" state) & 1)) = 0 ] && growth "$rtag" 0 37 1
    fi
    for d in pa1esp pa1root pa1 pa2 pvc; do dmsetup remove $d; done
    pgctl release "$C1"; pgctl release "$C2"; pgctl remove "$V"
    [ "$rec" = 1 ] && dmsetup remove lw
    return 0
}

# ---- growth: extend through ntfs3 on view C, PG_GROW, reload, resize2fs -----
# ntfs3 writes new MFT records in the NTFS 3.0 layout, which the core refuses
# (INTERFACES 10.1a): if the extension needs one (an attribute list, when the
# free space is fragmented), PG_GROW must refuse it and make the claim read-
# only -- checked here with the ext4 unmounted first (XFAIL, see README).
# growth <tag> <record 0|1> <seed> <holes 0|1>: with holes=0 the earlier
# fill is deleted first (free space back in one piece, mostly); with holes=1
# the extension goes into whatever holes the stress left.
growth() {
    gtag="$1 growth"; rec=$2 gs=$3
    [ "$4" = 1 ] && gtag="$1 growth into holes"
    mount_all rw || { bad "$gtag: mounts"; return; }
    [ "$4" = 1 ] || { rm -rf /mnt/c/fill11 && sync; }
    old=$(lim "$C2")
    [ "$rec" = 1 ] && dmsetup message lw 0 mark grow
    dd if=/dev/zero of=/mnt/c/paguro/bare.img bs=1M count=64 oflag=append conv=notrunc 2>/dev/null &&
        sync && ok "$gtag: bare.img extended by 64 MiB through ntfs3 on view C" || bad "$gtag: extend"
    paguro-harness ntfs-map "$VDEV" $ID2 > /tmp/map.post.2
    cp /tmp/map.pre.1 /tmp/map.post.1
    if grep -q "^error 12 " /tmp/map.post.2; then
        umount /mnt/r2
        set -- $(pgctl grow "$C2")
        [ $(($2 & 1)) = 1 ] && [ "$8" = 12 ] &&
            echo "XFAIL: $gtag: ntfs3 gave bare.img an NTFS 3.0-layout extension record; PG_GROW refused it (RecordLayout) and the claim is read-only" ||
            bad "$gtag: grow over an NTFS 3.0 record: $*"
        e2fsck -fn /dev/mapper/pa2 > /dev/null 2>&1 && ok "$gtag: the refused claim's view A still reads a clean ext4" ||
            bad "$gtag: e2fsck after the refused growth"
        rm -f /tmp/map.post.2
        umount_rest() { umount /mnt/e1; umount /mnt/r1; umount /mnt/c; }
        umount_rest
        return
    fi
    set -- $(pgctl grow "$C2")
    [ "$2" = 0 ] && [ "$4" = $((old + 131072)) ] && ok "$gtag: PG_GROW accepted ($old -> $4)" ||
        { bad "$gtag: grow: $*"; umount_all; return; }
    pgctl crosscheck "$C2" /mnt/c/paguro/bare.img > /dev/null && ok "$gtag: grown claim cross-checked" ||
        bad "$gtag: cross-check after growth"
    dmsetup reload pa2 --table "0 $(lim "$C2") paguro-image $C2" && dmsetup resume pa2 &&
        ok "$gtag: view A reloaded under the mounted ext4" || { bad "$gtag: reload"; umount_all; return; }
    resize2fs /dev/mapper/pa2 > /tmp/resize.out 2>&1 &&
        [ $(($(df -k /mnt/r2 | awk 'NR == 2 {print $2}') * 10 > $(lim "$C2") * 4)) = 1 ] &&
        ok "$gtag: resize2fs grew the mounted ext4 ($(df -k /mnt/r2 | awk 'NR == 2 {print $2}') KiB)" ||
        { bad "$gtag: resize2fs"; cat /tmp/resize.out; }
    [ "$rec" = 1 ] && dmsetup message lw 0 mark grown
    stress "$gtag" $gs
    sync; tag=$gtag; verify_all $gs
    umount_all
    check_offline "$gtag"
    maps_agree "$gtag" "$VDEV"; guard_quiet "$gtag" "$V"
    if [ -x /sbin/ntfsck ]; then
        h0=$(vstat "$V" guard)
        ntfsck -n -q /dev/mapper/pvc > /tmp/ntfsck.out 2>&1; rc=$?
        info "$gtag: ntfsck -n through view C: exit $rc, $(($(vstat "$V" guard) - h0)) refused reads of claimed sectors"
    fi
}

# ---- power-loss replay (INTERFACES 12.1) ------------------------------------
cat > /bin/replaycheck <<'CHECK'
#!/bin/sh
# At one replayed state of /dev/vdd: the Rust reference and the C core in
# userspace (paguro-harness ntfs-map, which fails on any disagreement) and
# the module's C core (PG_VOLUME_ADD, PG_CLAIM, then PG_CROSSCHECK against
# the Rust map: exact equality) must give the pre- or post-operation map, a
# map between them (inside a growth), or the same typed refusal.
. /tmp/replay.env
n=$(cat /tmp/replay.n 2>/dev/null || echo 0); n=$((n + 1)); echo $n > /tmp/replay.n
fail() { echo "REPLAY FAIL at $PG_STATE: $*"; exit 1; }
V=$(pgctl add /dev/vdd /dev/vdd 2>/dev/null) || { echo "$PG_STATE volume refused: $V" >> /tmp/replay.log; exit 0; }
cls=""
for i in 1 2; do
    eval "set -- \$ID$i; fmt=\$FMT$i"
    paguro-harness ntfs-map /dev/vdd "$1" "$2" > /tmp/r.map 2>/tmp/r.err || { pgctl remove $V; fail "C/Rust: $(cat /tmp/r.err)"; }
    if grep -q ^error /tmp/r.map; then
        code=$(awk '{print $2}' /tmp/r.map)
        out=$(pgctl claim "$V" "$1" "$2" $fmt 2>/dev/null) && { pgctl release "$out"; pgctl remove $V; fail "module accepted what Rust refused ($(cat /tmp/r.map))"; }
        case "$out" in "error $code "*) ;; *) pgctl remove $V; fail "module refused differently: $out vs $(cat /tmp/r.map)" ;; esac
        cls="$cls refused:$(awk '{print $3}' /tmp/r.map)"; continue
    fi
    if cmp -s /tmp/r.map /tmp/map.pre.$i; then c=pre
    elif cmp -s /tmp/r.map /tmp/map.post.$i; then c=post
    elif paguro-harness ntfs-between /tmp/map.pre.$i /tmp/r.map /tmp/map.post.$i; then c=between
    else pgctl remove $V; fail "image $i: a different map"; fi
    C=$(pgctl claim "$V" "$1" "$2" $fmt 2>/dev/null) || { pgctl remove $V; fail "module refused ($C) what Rust accepted"; }
    pgctl crosscheck-list "$C" /tmp/r.map > /dev/null || { pgctl release $C; pgctl remove $V; fail "module map != Rust map (image $i)"; }
    # ext4 consistency at a sample of states: view A copied out (the claim
    # is read-only: the replayed volume is dirty), mounted once from the
    # copy (journal replay), then e2fsck -fn.
    if [ $((n % EFSCK)) = 0 ] && [ "$c" != between ]; then
        len=$(pgctl status | awk -v c=$C '$1 == "claim" && $2 == c { for (k = 1; k < NF; k++) if ($k == "sectors") print $(k + 1) }')
        dmsetup create rva --readonly --table "0 $len paguro-image $C" && dmsetup mknodes ||
            { pgctl release $C; pgctl remove $V; fail "replayed view A refused"; }
        if [ $i = 1 ]; then
            dd if=/dev/mapper/rva of=/tmp/fs.img bs=1M skip=$((ROOT_S * 512)) count=$((ROOT_N * 512)) \
                iflag=skip_bytes,count_bytes 2>/dev/null
        else
            dd if=/dev/mapper/rva of=/tmp/fs.img bs=1M 2>/dev/null
        fi
        dmsetup remove rva
        L=$(losetup -f); losetup "$L" /tmp/fs.img
        mount -t ext4 "$L" /mnt/y 2>/tmp/r.mnt && umount /mnt/y ||
            { losetup -d "$L"; pgctl release $C; pgctl remove $V; fail "image $i: ext4 does not mount after replay ($(cat /tmp/r.mnt))"; }
        e2fsck -fn "$L" > /tmp/r.fsck 2>&1 ||
            { tail -20 /tmp/r.fsck; losetup -d "$L"; pgctl release $C; pgctl remove $V; fail "image $i: e2fsck after journal replay"; }
        losetup -d "$L"; rm -f /tmp/fs.img
        c="$c+fsck"
    fi
    pgctl release "$C"
    cls="$cls $c"
done
pgctl remove "$V"
echo "$PG_STATE:$cls" >> /tmp/replay.log
exit 0
CHECK
chmod +x /bin/replaycheck

replay() {
    tag=$1
    set -- $(pgreplay info /dev/vdc | tail -1)
    info "log: $*"
    {
        echo "ID1=\"$ID1\" ID2=\"$ID2\" FMT1=vhd FMT2=raw EFSCK=$EFSCK"
        echo "ROOT_S=$D1_ROOT_START ROOT_N=$D1_ROOT_LEN"
    } > /tmp/replay.env
    [ -e /tmp/map.post.2 ] || { cp /tmp/map.pre.2 /tmp/map.post.2; cp /tmp/map.pre.1 /tmp/map.post.1; }
    : > /tmp/replay.log; echo 0 > /tmp/replay.n
    pgreplay walk /dev/vdc /dev/vdd $REPLAY -- /bin/replaycheck > /tmp/replay.out 2>&1
    rc=$?
    tail -3 /tmp/replay.out
    states=$(wc -l < /tmp/replay.log)
    # Per state: "<state>: <image 1 class> <image 2 class>" (+fsck: checked).
    sed 's/^[a-z]* [0-9 /]*: *//; s/^[a-z]* [0-9]* //' /tmp/replay.log | sort | uniq -c |
        while read -r n c; do info "replay: $n states: $c"; done
    info "replay: $(grep -c '^subset' /tmp/replay.log) subset states, $(grep -c '^write' /tmp/replay.log) write prefixes"
    [ $rc = 0 ] && ok "$tag: $states replayed states: every map pre, post, between or the same refusal in Rust and the module" ||
        bad "$tag: replay ($rc): $(grep 'REPLAY FAIL' /tmp/replay.out | head -3)"
}

# ---- the phases ---------------------------------------------------------------
if has coexist; then
    rec=0; has replay && rec=1
    run "512e" /dev/vda 0 /dev/vde /dev/vdf D1 $rec 1
    [ $rec = 1 ] && replay "512e"
fi
if has frag; then
    FD=$(disk frag)
    if [ -n "$FD" ]; then
        rm -f /tmp/map.post.*
        run "fragmented" "$FD" built /dev/vde /dev/vdf D1 0 1
        [ "${NX1:-0}" -gt 20 ] && [ "${NX2:-0}" -gt 20 ] && ok "fragmented: images really fragmented ($NX1, $NX2 extents)" ||
            bad "fragmented: only $NX1/$NX2 extents"
    else
        echo "SKIP: fragmented (frag.img needs root + ntfs-3g on the host)"
    fi
fi
if has 4kn; then
    rm -f /tmp/map.post.*
    run "4Kn" /dev/vdb 0 /dev/vdg /dev/vdh D4 0 1
fi
has guard && . /guard.body

# ---- teardown ------------------------------------------------------------------
pgctl status
rmmod dm-paguro && ok "module unloads cleanly" || bad "rmmod"
dmesg | grep -E "BUG|Oops|WARNING|refcount|KASAN|EXT4-fs error|ntfs3.*(error|corrupt)" && bad "kernel complained" || ok "no kernel warnings or filesystem errors"
[ $fail = 0 ] && echo "RESULT: ALL PASS" || echo "RESULT: FAILURES"
poweroff -f

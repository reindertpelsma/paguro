#!/bin/sh
# initramfs-tools hook: paguro-initrd, dm-paguro, paguro-handoff and what
# they need (dm-crypt, dm-zero, ntfs3, vfat, efivarfs) in every initramfs.
#
# Refuses to build an initramfs without dm-paguro for this kernel
# (INTERFACES.md §11.6): a DKMS build failure must fail the kernel's
# install loudly, so the previous kernel stays the default, rather than
# produce an initramfs that cannot find its root.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
    prereqs) prereqs; exit 0 ;;
esac

. /usr/share/initramfs-tools/hook-functions

for m in dm-paguro paguro-handoff; do
    if ! modinfo -k "${version:?}" "$m" >/dev/null 2>&1; then
        echo "paguro: $m is not built for kernel $version; refusing to build an initramfs that cannot find its root" >&2
        exit 1
    fi
done
manual_add_modules dm-paguro paguro-handoff dm-crypt dm-zero ntfs3 vfat \
    nls_cp437 nls_iso8859-1 efivarfs
copy_exec /usr/sbin/paguro-initrd /usr/sbin

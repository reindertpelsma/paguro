# paguro configuration. Not hand-editable: use `paguro config`.
[Paguro]
version = 1
default = debian

[Boot.debian]
volume = 5c5c5c5c-5c5c-5c5c-5c5c-5c5c5c5c5c5c
root = \paguro\debian.vhd

[Passphrase]
enabled = 1

[Boot.arch]
volume = 6d6d6d6d-6d6d-6d6d-6d6d-6d6d6d6d6d6d
root = \paguro\arch.img
efi_disk = \paguro\arch-esp.vhd
efi = \EFI\systemd\systemd-bootx64.efi
[Boot.rescue]
volume = 6d6d6d6d-6d6d-6d6d-6d6d-6d6d6d6d6d6d
efi_file = \paguro\rescue.efi
